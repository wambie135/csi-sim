/glg4debug/glg4param omit_muon_processes  0.0
/glg4debug/glg4param omit_hadronic_processes  0.0

#set the detector parameters
/rat/db/set DETECTOR experiment "BNL30T"
/rat/db/set DETECTOR geo_file "BNL30T/practice.geo"

/rat/db/set PMT[lappd] width 3.0
/rat/db/set PMT[lappd] thick 0.25
/rat/db/set PMT[lappd] glass_thickness 0.01

/rat/db/set OPTICS[photocathode_lappd] EFFICIENCY_option "wavelength"
#/rat/db/set OPTICS[photocathode_lappd] EFFICIENCY_value1 [120.0,125.0,130.0,135.0,140.0,145.0,150.0,155.0,160.0,165.0,170.0,175.0,180.0,185.0,190.0,195.0,200.0,220.0,240.0,260.0,280.0,300.0,320.0,340.0,360.0,380.0,400.0,420.0,440.0,460.0,480.0,500.0,520.0,540.0,560.0,580.0,600.0]
