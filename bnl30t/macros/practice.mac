/rat/db/set OPTICS[photocathode_lappd] EFFICIENCY_value2 [0.02,0.135,0.16,0.175,0.195,0.225,0.235,0.249,0.25,0.245,0.23,0.205,0.185,0.16,0.1475,0.125,0.105,0.095,0.085,0.07,0.06,0.05,0.04,0.0325,0.025,0.0225]
